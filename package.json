{
  "name": "wb-mates-traitors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The W.B. Mates Traitors: a no-moderator Mafia game for the pub",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bots": "tsx scripts/bots.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
